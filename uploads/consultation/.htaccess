# CustomCore — consultation attachment storage hardening (Commit 14.10).
#
# These files are PRIVATE. They are delivered only through the application
# endpoints consultation-attachment.php / admin/consultation-attachment.php,
# which stream the bytes server-side (readfile) after an ownership/admin check.
# Nothing in this directory should ever be fetched directly over HTTP, so all
# direct access is denied. The download endpoints are unaffected because they
# read from the filesystem, not through the web server.
#
# Notes:
#   - Works on Apache 2.2 and 2.4 (authz guarded per version).
#   - Ignored by the PHP built-in server and non-Apache stacks.

# No directory listings.
Options -Indexes

# Deny all direct web access to stored attachments.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Also turn the PHP engine off where mod_php is active (defence in depth).
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_admin_flag engine off
</IfModule>
