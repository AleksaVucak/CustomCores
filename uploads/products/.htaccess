# CustomCore — product image storage hardening.
#
# Product images in this directory are served directly (e.g. <img src>), but
# the directory must NEVER execute code. Uploads are already restricted to
# finfo-verified image types with random, extension-controlled names, so a
# script can't normally land here; this file is defence in depth in case the
# application controls are ever bypassed.
#
# Notes:
#   - Works on Apache 2.2 and 2.4 (authz guarded per version).
#   - php_admin_flag applies only under mod_php; harmless under PHP-FPM/CGI.
#   - Ignored by the PHP built-in server and non-Apache stacks.

# No directory listings.
Options -Indexes

# Turn the PHP engine off where mod_php is active.
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_admin_flag engine off
</IfModule>

# Refuse to serve or execute anything that could run as code.
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pht|phar|cgi|pl|py|asp|aspx|jsp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
